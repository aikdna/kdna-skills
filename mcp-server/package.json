{
  "name": "@aikdna/kdna-mcp-server",
  "version": "0.5.0",
  "description": "Thin MCP adapter for user-approved KDNA workspace attachments.",
  "type": "module",
  "homepage": "https://aikdna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aikdna/kdna-skills.git",
    "directory": "mcp-server"
  },
  "bugs": {
    "url": "https://github.com/aikdna/kdna-skills/issues"
  },
  "keywords": [
    "kdna",
    "mcp",
    "ai-agent",
    "judgment",
    "loadplan",
    "workspace"
  ],
  "bin": {
    "kdna-mcp": "bin/kdna-mcp.mjs"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "node scripts/verify-runtime-candidates.mjs && node ../scripts/check-current-names.mjs && node --test test/*.test.mjs && npm run check:orphan-lockfile",
    "check:runtime-candidates": "node scripts/verify-runtime-candidates.mjs",
    "check:current-names": "node ../scripts/check-current-names.mjs",
    "naming:check": "node ../scripts/check-current-names.mjs",
    "release:check": "node ../scripts/release-check.js",
    "release:dependency-guard": "node ../scripts/release-dependency-guard.js",
    "release:preflight": "node ../scripts/release-preflight.js",
    "prepublishOnly": "npm test && npm run release:check && npm run release:dependency-guard",
    "check:orphan-lockfile": "node scripts/check-orphan-lockfile.mjs"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@aikdna/kdna-cli": "0.36.1"
  },
  "kdna_runtime": {
    "cli": "0.36.1",
    "core": "0.21.0",
    "workspace_schema": "0.3.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  }
}
